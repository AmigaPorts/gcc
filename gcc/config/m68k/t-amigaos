# Makefile fragment for AmigaOS target.

EXTRA_OBJS += amigaos.o m68k2.o m68k_costs.o

# Extra object file linked to the driver, for the -mcrt= consistency check.
driver-amigaos.o: $(srcdir)/config/m68k/driver-amigaos.cc
	$(COMPILE) $<
	$(POSTCOMPILE)

# Extra object files linked to the cc1* executables.  Compile them with
# $(COMPILE) so their header dependencies are tracked automatically, as the
# other backends do: with only $(CONFIG_H) as a prerequisite an options.h
# change left m68k2.o reading the option variables at stale offsets.
amigaos.o: $(srcdir)/config/m68k/amigaos.cc
	$(COMPILE) $<
	$(POSTCOMPILE)

m68k2.o: $(srcdir)/config/m68k/m68k2.cc
	$(COMPILE) $<
	$(POSTCOMPILE)

m68k_costs.o: $(srcdir)/config/m68k/m68k_costs.cc
	$(COMPILE) $<
	$(POSTCOMPILE)

# Additional target dependent options for compiling libgcc.a.  This just
# ensures that we don't compile libgcc* with anything other than a
# fixed stack.

#TARGET_LIBGCC2_CFLAGS = -mfixedstack

### begin-GG-local: dynamic libraries
# Extra objects that get compiled and linked to collect2

EXTRA_COLLECT2_OBJS = amigacollect2.o

# Build supplimentary AmigaOS target support file for collect2
amigacollect2.o: amigacollect2.cc
	$(CXX) -c $(ALL_CFLAGS) $(ALL_CPPFLAGS) $(INCLUDES) \
	-DA2IXDIR_PREFIX=\"$(prefix)/share/a2ixlibrary\" $< $(OUTPUT_OPTION)
### end-GG-local

# Support for building multiple version of libgcc, libquadmath, libobjc and libstdc++-v3
#
# The 68020-class libraries (libm020, with and without the FPU) are built with
# -m68020-60: the instructions common to the 68020, 68030, 68040 and 68060.
# Built with -m68020 they used fmovecr, 64-bit mulu.l/divu.l and fintrz,
# which the 68040 and 68060 do not implement: they trap into 68040.library or
# 68060.library, so a program linked before SetPatch crashed and every such
# instruction after it cost hundreds of cycles.  The same libraries serve
# every CPU from the 68020 up, so there is no separate 68060 flavor.
MULTILIB_OPTIONS    = fbaserel/fbaserel32 m68020-60 m68881
MULTILIB_DIRNAMES   = libb libb32 libm020 libm881
MULTILIB_EXTRA_OPTS =
MULTILIB_EXCEPTIONS = fbaserel/m68881 fbaserel32 fbaserel32/m68881 m68881
# Every spelling of a 68020-class or better CPU selects the multilib built for
# it. Without these matches only -m68020-60 leaves the 68000 libraries: every
# -m680x0, -mcpu= and -march= spelling linked the 68000 libgcc, libstdc++ and
# libnix into code generated for an 020 or better.
# -mhard-float is the same option as -m68881 (both set MASK_HARD_FLOAT, so
# doubles come back in fp0); without the match it linked the soft-float libm,
# whose results in d0/d1 the caller never looked at.
# -resident and -resident32 generate base-relative code, so they must select
# the matching multilibs even without an explicit -fbaserel option.
MULTILIB_MATCHES    = m68020-60=mcpu?68020 m68020-60=mcpu?68030 \
                      m68020-60=mcpu?68040 m68020-60=mcpu?68060 \
                      m68020-60=m68020-40 \
                      m68020-60=march?68020 m68020-60=march?68030 \
                      m68020-60=march?68040 m68020-60=march?68060 \
                      m68881=mhard-float \
                      fbaserel=resident fbaserel32=resident32
